{
  "name": "podcast-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Pipeline tự động tạo video động từ audio (Remotion + Whisper local)",
  "scripts": {
    "remotion-studio": "remotion studio",
    "studio": "concurrently -n server,ui -c blue,magenta \"npm:studio:server\" \"npm:studio:ui\"",
    "studio:server": "tsx watch server/index.ts",
    "studio:ui": "cd ui && npm run dev",
    "setup": "tsx scripts/setup-whisper.ts",
    "make": "tsx scripts/make.ts",
    "preview": "tsx scripts/make.ts --preview",
    "spell-fix": "tsx scripts/spell-fix.ts",
    "render": "remotion render",
    "migrate": "tsx scripts/migrate-json-to-sqlite.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@remotion/bundler": "^4.0.420",
    "@remotion/captions": "4.0.420",
    "@remotion/cli": "4.0.420",
    "@remotion/google-fonts": "4.0.420",
    "@remotion/install-whisper-cpp": "4.0.420",
    "@remotion/media-parser": "4.0.420",
    "@remotion/media-utils": "4.0.420",
    "@remotion/renderer": "4.0.420",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.25",
    "jsonrepair": "^3.14.0",
    "openai": "^4.104.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.420",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "concurrently": "^10.0.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
